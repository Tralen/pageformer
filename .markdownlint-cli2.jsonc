{
  // Legal documents use long paragraphs and compact tables.
  "config": {
    "MD013": false,
    "MD060": false,
    // The frontmatter carries the document title; an H1 starts a section.
    "MD025": false,
    // Bold or italic lines are deliberate legal headings.
    "MD036": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    ".handoff/**",
    ".prompt/**",
    "target/**",
    "HANDOFF.md",
    "PROMPT.md",
    "TODO.md",
    "COMPLIANCE.md",
    "REGRESSION.md",
    "EDITORIAL.md",
    "SKETCH.md"
  ]
}
